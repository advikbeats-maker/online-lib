import os
import time
import threading
from concurrent.futures import ThreadPoolExecutor

import requests

BOT_TOKEN = os.environ.get("BOT_TOKEN", "PASTE_YOUR_TOKEN_HERE")
API_URL = f"https://api.telegram.org/bot{BOT_TOKEN}/"

KEYBOARD = {
    "keyboard": [
        [{"text": "Games"}, {"text": "Setup"}],
        [{"text": "Purchased Keys"}],
    ],
    "resize_keyboard": True,
    "is_persistent": True,
}

_local = threading.local()


def session():
    """One reused connection per thread."""
    if not hasattr(_local, "s"):
        _local.s = requests.Session()
    return _local.s


def api(method, data=None, timeout=(5, 15)):
    try:
        r = session().post(API_URL + method, json=data or {}, timeout=timeout)
        j = r.json()
        if not j.get("ok"):
            print(f"API error {method}: {j}")
            if j.get("error_code") == 429:
                time.sleep(j.get("parameters", {}).get("retry_after", 1))
        return j
    except Exception as e:
        print(f"Network error {method}: {e}")
        return {}


def send(chat_id, text, **extra):
    return api("sendMessage", {"chat_id": chat_id, "text": text, **extra})


def handle(message):
    try:
        chat_id = message["chat"]["id"]
        text = (message.get("text") or "").strip()
        cmd = text.split(" ")[0].split("@")[0].lower() if text else ""

        if cmd == "/start":
            send(chat_id, "Welcome!\n\nPlease choose an option below:",
                 reply_markup=KEYBOARD)

        elif cmd == "/ping":
            a = time.perf_counter()
            res = send(chat_id, "🏓 Pinging...")
            first = round((time.perf_counter() - a) * 1000)

            b = time.perf_counter()
            api("getMe")
            second = round((time.perf_counter() - b) * 1000)

            msg_id = res.get("result", {}).get("message_id")
            if msg_id:
                api("editMessageText", {
                    "chat_id": chat_id,
                    "message_id": msg_id,
                    "text": f"🏓 Pong!\n⏱ First call: {first} ms\n⚡ Next call: {second} ms",
                })

        elif text in ("Games", "Setup", "Purchased Keys"):
            send(chat_id, f"You selected: {text}\n\nResponse coming soon.")

        else:
            send(chat_id, "Please use /start and select an option from the keyboard.")

    except Exception as e:
        print("Handler error:", e)


def main():
    # Polling and webhooks can't run together
    api("deleteWebhook", {"drop_pending_updates": True})

    me = api("getMe").get("result", {})
    print(f"Bot started as @{me.get('username')}")

    pool = ThreadPoolExecutor(max_workers=10)
    offset = None
    delay = 1

    while True:
        try:
            params = {"timeout": 30, "allowed_updates": ["message"]}
            if offset:
                params["offset"] = offset

            r = requests.post(API_URL + "getUpdates", json=params, timeout=(5, 40))
            j = r.json()

            if not j.get("ok"):
                print("getUpdates error:", j)
                if j.get("error_code") == 409:
                    print("Another copy of this bot (or a webhook) is running. Stop it first.")
                time.sleep(delay)
                delay = min(delay * 2, 30)
                continue

            delay = 1
            for u in j["result"]:
                offset = u["update_id"] + 1
                if "message" in u:
                    pool.submit(handle, u["message"])

        except KeyboardInterrupt:
            print("Stopped")
            break
        except Exception as e:
            print(f"Polling error: {e}, retrying in {delay}s")
            time.sleep(delay)
            delay = min(delay * 2, 30)


if __name__ == "__main__":
    main()
